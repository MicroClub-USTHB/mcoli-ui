  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm run build:registry && pnpm run build:docs && pnpm run build:prod",
    "build:registry": "concurrently \"pnpm run build:registry:internal\" \"pnpm run build:registry:external\"",
    "build:registry:internal": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "build:registry:external": "shadcn build ./__registry__/registry.autogenerated.json",
    "build:docs": "fumadocs-mdx",
    "build:prod": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.7.7",
    "fumadocs-mdx": "^14.2.11",
    "fumadocs-ui": "^16.7.7",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/nextjs": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chromatic": "^16.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "eslint-plugin-storybook": "^10.4.1",
    "rimraf": "^6.1.3",
    "shadcn": "^4.1.1",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2"
  }
}
